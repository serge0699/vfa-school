bit sync_q[$:0];

string msg; int num;

initial begin

    common_resource_db#(string)::set("to_bob", "hello_from_alice", "Hello, Bob!");
    common_resource_db#(int   )::set("numbers", "my_new_number", 256);

    sync_q.push_back(1'b1);

    wait (sync_q.size() == 0);

    if( !common_resource_db#(string)::get("to_alice", "hello_from_bob", msg) ) begin
        $error("Can't get 'hello_from_bob' from resource_db!");
    end
    else begin
        if( msg != "Hello, Alice!" )
            $error("'hello_from_bob' is not 'Hello, Alice!'");
    end

    if( !common_resource_db#(int)::get("numbers", "my_number", num) ) begin
        $error("Can't get 'my_number' from resource_db!");
    end
    else begin
        if( num != 128 )
            $error("'my_number' is not 128!");
    end

end
